rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Regra de ouro: O usuário autenticado só pode ler e gravar documentos
    // dentro do seu próprio caminho (/users/{userId}/...)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}

